# ================================================================================================
#  🏰 GoFortress Custom Configuration
# ================================================================================================
#
#  Purpose: Custom configuration for GoFortress, a Go project fortress.
#
#  Override Strategy:
#  - This file is used to override default settings in the GoFortress configuration.
#
# Tools:
#  - GoFortress
#  - go-coverage
#  - go-pre-commit
#  - GitHub Workflows
#
#  Maintainer: @mrz1836
#
# ================================================================================================

# Feature Toggle
ENABLE_CI_GUARDIAN=true

# Provider
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (only used when provider=codecov)
CODECOV_TOKEN_REQUIRED=true

# Exclude CI test fixtures from pre-commit checks (they contain intentionally broken code)
# Also exclude magefiles/ (build-tagged files can't be linted without the mage tag)
GO_PRE_COMMIT_EXCLUDE_PATTERNS=vendor/,node_modules/,.git/,.github/ci-tester/fixtures/,magefiles/

# Exclude CI test fixtures from MAGE-X format checks (they contain intentionally broken code)
MAGE_X_FORMAT_EXCLUDE_PATHS=vendor,node_modules,.git,.idea,.github/ci-tester/fixtures

# Exclude CI test fixture modules from MAGE-X testing/benchmarks (they contain intentionally broken code)
# Also exclude magefiles module (has no test files, only build-tagged magefile)
MAGE_X_TEST_EXCLUDE_MODULES=fixture-cache-test,fixture-cov-fail,fixture-env-test,fixture-fork-test,fixture-lint-fail,fixture-matrix-test,fixture-pass-basic,fixture-race-fail,fixture-sbom-test,fixture-sec-fail,fixture-slsa-test,fixture-test-fail,fixture-vuln-fail,magefiles

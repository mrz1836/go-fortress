# ================================================================================================
#  🏰 GoFortress Custom Configuration
# ================================================================================================
#
#  Purpose: Custom configuration for GoFortress, a Go project fortress.
#
#  Override Strategy:
#  - This file is used to override default settings in the GoFortress configuration.
#
# Tools:
#  - GoFortress
#  - go-coverage
#  - go-pre-commit
#  - GitHub Workflows
#
#  Maintainer: @mrz1836
#
# ================================================================================================

# Custom Coverage Exclusions
GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,examples/,plans/,docs/

# Skip URL Checks in Coverage Reports (true/false)
GO_COVERAGE_SKIP_URL_CHECKS=true

# Google Analytics Configuration (for coverage pages)
#GOOGLE_ANALYTICS_ID=

# Provider
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (only used when provider=codecov)
CODECOV_TOKEN_REQUIRED=true

# Exclude CI test fixtures from pre-commit checks (they contain intentionally broken code)
GO_PRE_COMMIT_EXCLUDE_PATTERNS=vendor/,node_modules/,.git/,.github/ci-tester/fixtures/

# Exclude CI test fixture modules from MAGE-X testing/benchmarks (they contain intentionally broken code)
MAGE_X_TEST_EXCLUDE_MODULES=fixture-cache-test,fixture-cov-fail,fixture-env-test,fixture-fork-test,fixture-lint-fail,fixture-matrix-test,fixture-pass-basic,fixture-race-fail,fixture-sbom-test,fixture-sec-fail,fixture-slsa-test,fixture-test-fail,fixture-vuln-fail

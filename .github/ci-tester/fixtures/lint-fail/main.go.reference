// Package main - REFERENCE FILE FOR lint-fail FIXTURE
//
// DO NOT USE THIS FILE DIRECTLY!
//
// This file documents the intentional violations that the ci.yml workflow
// generates at runtime. The actual main.go is generated dynamically via printf
// commands in the workflow to prevent format auto-fixing tools from "fixing"
// the intentional violations.
//
// The workflow generates code with the following intentional issues:
//
// 1. LINT JOB (LINT-001 scenario):
//    - Unused variables: unusedVar, anotherUnused
//    - These are compile errors that go vet and go build will catch
//    - Cannot be auto-fixed by any tool
//
// 2. FORMAT JOB (LINT-002 scenario):
//    - Spaces instead of tabs in badlyFormatted() function
//    - gofmt will detect this as a formatting violation
//    - MUST be generated at runtime since gofmt/gofumpt would auto-fix it
//
// 3. GOLANGCI-LINT JOB (LINT-003 scenario):
//    - Unused variables trigger golangci-lint rules
//
// 4. STATICCHECK JOB (LINT-004 scenario):
//    - Discarded pure function result: fmt.Sprintf() return value ignored
//    - Triggers staticcheck SA4017 (pure function result discarded)
//
// Example of what the generated code looks like:
//
// package main
//
// import "fmt"
//
// func main() {
//     unusedVar := "this triggers lint failure"    // <- Unused variable
//     anotherUnused := 42                          // <- Unused variable
//     fmt.Println("Hello, World!")
// }
//
// func badlyFormatted() string {
//     x := 1  // <- 4 SPACES instead of TAB (format violation)
//     return fmt.Sprintf("%d", x)
// }
//
// func main() {
//     msg := "hello"
//     fmt.Sprintf("%s world", msg)                    // <- Result discarded (SA4017)
//     fmt.Println(msg)
// }
package main

// This file is intentionally not valid Go code - it's documentation only.
// The actual code is generated by the ci.yml workflow.

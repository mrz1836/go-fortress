# ================================================================================================
# 🎨 PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides and customizations
# Load Order: 90 (near end, overrides all earlier files)
#
# This file is for PROJECT-SPECIFIC configuration that differs from go-fortress defaults.
# It is tracked in git and synced by go-broadcast.
#
# Use this file to:
# - Override default tool versions for compatibility
# - Customize coverage thresholds or exclusions
# - Adjust workflow behavior for this specific project
# - Set project-specific feature flags
# - Configure tool behavior specific to this codebase
#
# DO NOT USE FOR:
# - Local developer preferences (use 99-local.env instead)
# - Secrets or API keys (use GitHub Secrets)
# - Temporary testing overrides (use 99-local.env instead)
#
# Load Order: This file loads after all 00-* and 10-* and 20-* files,
# so any variables set here will override the defaults from those files.
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

GO_PRIMARY_VERSION=1.25.x
GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_VERSION=1.25.x

# ================================================================================================
# 🎯 CI Guardian (test framework)
# ================================================================================================
ENABLE_CI_GUARDIAN=true
GUARDIAN_PARALLEL_SCENARIOS=2
GUARDIAN_ACTIONLINT_VERSION=v1.7.7

# ================================================================================================
# 📊 Coverage Configuration
# ================================================================================================
# Use Codecov instead of internal GitHub Pages deployment
GO_COVERAGE_PROVIDER=codecov
CODECOV_TOKEN_REQUIRED=true

# ================================================================================================
# 🪄 MAGE-X Configuration
# ================================================================================================

# Exclude CI test fixture modules from testing/benchmarks (intentionally broken code)
# Also exclude magefiles module (has no test files, only build-tagged magefile)
MAGE_X_TEST_EXCLUDE_MODULES=fixture-cache-test,fixture-cov-fail,fixture-env-test,fixture-fork-test,fixture-lint-fail,fixture-matrix-test,fixture-pass-basic,fixture-race-fail,fixture-sec-fail,fixture-slsa-test,fixture-test-fail,fixture-vuln-fail,magefiles

# Exclude CI test fixtures from format checks (intentionally broken code)
MAGE_X_FORMAT_EXCLUDE_PATHS=vendor,node_modules,.git,.idea,.github/ci-tester/fixtures

# ================================================================================================
# 🪝 Pre-Commit Configuration
# ================================================================================================
# Exclude CI test fixtures (intentionally broken code) and magefiles (build-tagged)
GO_PRE_COMMIT_EXCLUDE_PATTERNS=vendor/,node_modules/,.git/,.github/ci-tester/fixtures/,magefiles/

# ================================================================================================
# 🔐 Gitleaks Configuration
# ================================================================================================
GITLEAKS_CONFIG_FILE=.github/.gitleaks.toml

# ================================================================================================
# 🛡️ Shared Vulnerability Exclusions (Nancy / Govulncheck / OSV-Scanner)
# ================================================================================================
# Single source of truth for advisory IDs suppressed across all dependency scanners. The
# fortress-security-scans workflow merges this into EFFECTIVE_VULN_EXCLUDES; each scanner
# consumes the IDs relevant to its namespace (CVE-* for Nancy, GO-*/GHSA-* for OSV-Scanner)
# and silently ignores the rest. Kept under the legacy NANCY_EXCLUDES name for cross-repo sync.
#
# Known acceptable vulnerabilities in transitive (indirect) dependencies that we do not
# pull in directly and cannot upgrade independently.
#
# golang.org/x/net@v0.52.0 (indirect, via github.com/rhysd/actionlint -> used only by the
# CI Guardian actionlint tooling, not by application code):
#   - CVE-2026-39821 idna ToASCII/ToUnicode Punycode privilege escalation (9.6 Critical)
#   - CVE-2026-25680 HTML parsing resource exhaustion / DoS (8.7 High)
#   - CVE-2026-27136 html.Render XSS (6.1 Medium)
#   - CVE-2026-42506 html.Render XSS (6.1 Medium)
#   - CVE-2026-25681 html.Render XSS (5.1 Medium)
#   - CVE-2026-42502 html.Render XSS (5.1 Medium)
#
# OSV-Scanner only (false positive from an intentionally-vulnerable CI test fixture):
#   OSV-Scanner runs `scan source -r .`, which recursively scans every go.mod — including
#   .github/ci-tester/fixtures/vuln-fail/go.mod, a fixture deliberately pinned to
#   golang.org/x/text@0.3.0 so SEC-003 can verify govulncheck detects it. Nancy and
#   Govulncheck skip it via MAGE_X_TEST_EXCLUDE_MODULES, but OSV-Scanner has no path
#   exclusion, so the fixture's known vuln must be ignored by ID here. This is NOT an app
#   dependency (the real module tree uses a modern x/text).
#   - GO-2021-0113 golang.org/x/text ParseAcceptLanguage DoS (aka CVE-2021-38561 /
#     GHSA-ppp9-7jff-5vj2, fixed in 0.3.7) — fixture-only, safe to exclude
NANCY_EXCLUDES=CVE-2026-39821,CVE-2026-25680,CVE-2026-27136,CVE-2026-42506,CVE-2026-25681,CVE-2026-42502,CVE-2026-46600,GO-2021-0113

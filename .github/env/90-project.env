# ================================================================================================
# 🎨 PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides and customizations
# Load Order: 90 (near end, overrides all earlier files)
#
# This file is for PROJECT-SPECIFIC configuration that differs from go-fortress defaults.
# It is tracked in git and synced by go-broadcast.
#
# Use this file to:
# - Override default tool versions for compatibility
# - Customize coverage thresholds or exclusions
# - Adjust workflow behavior for this specific project
# - Set project-specific feature flags
# - Configure tool behavior specific to this codebase
#
# DO NOT USE FOR:
# - Local developer preferences (use 99-local.env instead)
# - Secrets or API keys (use GitHub Secrets)
# - Temporary testing overrides (use 99-local.env instead)
#
# Load Order: This file loads after all 00-* and 10-* and 20-* files,
# so any variables set here will override the defaults from those files.
#
# ================================================================================================

# ================================================================================================
# 📝 PROJECT OVERRIDES
# ================================================================================================

# ------------------------------------------------------------------------------------------------
# 🎯 CI Guardian (test framework)
# ------------------------------------------------------------------------------------------------
ENABLE_CI_GUARDIAN=true
GUARDIAN_PARALLEL_SCENARIOS=2
GUARDIAN_ACTIONLINT_VERSION=v1.7.7

# ------------------------------------------------------------------------------------------------
# 📊 Coverage Configuration
# ------------------------------------------------------------------------------------------------
# Use Codecov instead of internal GitHub Pages deployment
GO_COVERAGE_PROVIDER=codecov
CODECOV_TOKEN_REQUIRED=true

# Example overrides (uncomment and customize as needed):
# GO_COVERAGE_THRESHOLD=75.0
# GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,examples/,internal/deprecated/

# ------------------------------------------------------------------------------------------------
# 🪄 MAGE-X Configuration
# ------------------------------------------------------------------------------------------------
# v1.18.7 causes SLSA-002 build isolation scenario to fail
MAGE_X_VERSION=v1.18.6

# Exclude CI test fixture modules from testing/benchmarks (intentionally broken code)
# Also exclude magefiles module (has no test files, only build-tagged magefile)
MAGE_X_TEST_EXCLUDE_MODULES=fixture-cache-test,fixture-cov-fail,fixture-env-test,fixture-fork-test,fixture-lint-fail,fixture-matrix-test,fixture-pass-basic,fixture-race-fail,fixture-sec-fail,fixture-slsa-test,fixture-test-fail,fixture-vuln-fail,magefiles

# Exclude CI test fixtures from format checks (intentionally broken code)
MAGE_X_FORMAT_EXCLUDE_PATHS=vendor,node_modules,.git,.idea,.github/ci-tester/fixtures

# Example overrides:
# MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,integration

# Redis Service (only if this project needs Redis)
# ENABLE_REDIS_SERVICE=true
# REDIS_SERVICE_MODE=always

# ------------------------------------------------------------------------------------------------
# 🪝 Pre-Commit Configuration
# ------------------------------------------------------------------------------------------------
# Exclude CI test fixtures (intentionally broken code) and magefiles (build-tagged)
GO_PRE_COMMIT_EXCLUDE_PATTERNS=vendor/,node_modules/,.git/,.github/ci-tester/fixtures/,magefiles/

# Example overrides:
# GO_PRE_COMMIT_BUILD_TAGS=integration,e2e
# GO_PRE_COMMIT_LINT_TIMEOUT=900

# ------------------------------------------------------------------------------------------------
# 🔐 Gitleaks Configuration
# ------------------------------------------------------------------------------------------------
GITLEAKS_CONFIG_FILE=.github/.gitleaks.toml

# Workflow Configuration
# STALE_DAYS_BEFORE_STALE=90
# AUTO_MERGE_MIN_APPROVALS=2

# Benchmark Configuration
# BENCHMARK_MODE=full
# BENCHMARK_TIMEOUT=30

# AI-Powered Text Generation (only if using go-broadcast in this repo)
# GO_BROADCAST_AI_ENABLED=true
# GO_BROADCAST_AI_PROVIDER=anthropic

# ================================================================================================
# 📌 NOTES
# ================================================================================================

# Remember:
# - Keep this file minimal - only override what's necessary
# - Document WHY you're overriding (compatibility, performance, etc.)
# - Use 99-local.env for personal/temporary overrides
# - This file is synced by go-broadcast to all repos
